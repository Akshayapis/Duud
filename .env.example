# Server
PORT=8080
APP_URL=https://your-domain.example
DATA_DIR=/var/uapp-data
REQUIRE_AUTH=true
DOWNLOAD_TTL_SECONDS=540
MAX_SOURCE_MB=150
MAX_ARTIFACT_MB=250
BUILD_UPLOAD_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Identity / quota (server-side)
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# Optional: only needed for future admin SDK writes. Token verification works with project ID alone.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Build engine (server-side only; never exposed to browsers)
KAGGLE_USERNAME=your-build-engine-account
KAGGLE_KEY=your-build-engine-api-key
KAGGLE_TIMEOUT_MINUTES=30
KAGGLE_WORKER_SLUG=uapp-android-build-worker

# Merchant UPI (server-side only; browsers cannot override)
UPI_ID=
UPI_PAYEE_NAME=

# Optional Vite build-time overrides (public Firebase config has a catalog fallback)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_UAPP_UPI_ID=
VITE_UAPP_UPI_NAME=
