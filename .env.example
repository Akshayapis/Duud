# U APP environment — pre-filled. Every secret is optional; built-in platform
# defaults already power Firebase and the Kaggle Android build engine.
VITE_FIREBASE_PROJECT_ID=dmakenow
VITE_FIREBASE_DATABASE_URL=https://dmakenow-default-rtdb.firebaseio.com

# ---------------------------------------------------------------------------
# Kaggle Android build engine (SERVER ONLY — never exposed to the browser)
# Defaults are wired in server/index.mjs. Override here if you rotate the key.
# ---------------------------------------------------------------------------
KAGGLE_USERNAME=<your kaggle username>
KAGGLE_KEY=<current kaggle api key>
KAGGLE_TIMEOUT_MINUTES=30
KAGGLE_WORKER_SLUG=uapp-android-build-worker

# Firebase token verification for build + artifact requests
FIREBASE_PROJECT_ID=dmakenow
FIREBASE_DATABASE_URL=https://dmakenow-default-rtdb.firebaseio.com
REQUIRE_AUTH=true

# Storage. On Render, mount a disk and point DATA_DIR at it for restart-safe
# preserved sources. Without a disk the server automatically falls back to /tmp.
DATA_DIR=/var/uapp-data
DOWNLOAD_TTL_SECONDS=540
BUILD_UPLOAD_SECRET=

# Future admin operations (payment approval, UPI settings) use this token.
ADMIN_TOKEN=
UPI_ID=
UPI_PAYEE_NAME=
APP_URL=

# Optional: live ad mediation endpoint
VITE_UAPP_ADS_ENDPOINT=
