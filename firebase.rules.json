{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,

        "profile": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false,
          "name": { ".write": "auth != null && auth.uid === $uid && newData.isString() && newData.val().length <= 120" },
          "email": { ".write": "auth != null && auth.uid === $uid && newData.isString()" },
          "provider": { ".write": "auth != null && auth.uid === $uid && newData.isString()" },
          "emailVerified": { ".write": "auth != null && auth.uid === $uid && newData.isBoolean()" },
          "createdAt": { ".write": "auth != null && auth.uid === $uid && newData.isString()" },
          "photo": { ".write": "auth != null && auth.uid === $uid && newData.isString()" },
          "bio": { ".write": "auth != null && auth.uid === $uid && newData.isString() && newData.val().length <= 500" },
          "company": { ".write": "auth != null && auth.uid === $uid && newData.isString() && newData.val().length <= 120" },
          "notifyBuilds": { ".write": "auth != null && auth.uid === $uid && newData.isBoolean()" },
          "notifyPayments": { ".write": "auth != null && auth.uid === $uid && newData.isBoolean()" },
          "notifyProduct": { ".write": "auth != null && auth.uid === $uid && newData.isBoolean()" },
          "planId": { ".write": false },
          "planActivatedAt": { ".write": false },
          "planExpiresAt": { ".write": false },
          "plan": { ".write": false },
          "subscription": { ".write": false },
          "quota": { ".write": false },
          "usedCredits": { ".write": false },
          "monthlyAllowance": { ".write": false }
        },

        "activity": {
          "$eventId": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "projects": {
          "$projectId": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "apiKeys": {
          "$keyId": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": false
          }
        },
        "devices": {
          "$tokenId": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "support": {
          "$requestId": {
            ".write": "auth != null && auth.uid === $uid",
            "deliveryStatus": { ".write": false },
            "adminReply": { ".write": false }
          }
        }
      }
    },

    "payments": {
      "$uid": {
        "$paymentId": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },

    "plans": {
      ".read": true,
      ".write": false
    },

    "builds": {
      "$projectId": {
        "$buildId": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('projects').child($projectId).exists()",
          ".write": false
        }
      }
    },

    "system": {
      ".read": false,
      ".write": false
    }
  }
}
